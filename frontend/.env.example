# FastAPI backend. No Next.js API routes are used — every read and write goes here.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical origin, used for the landing page's metadata URLs and Open Graph image.
# Set this to the deployed URL (e.g. https://<project>.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase browser credentials (anon key only; never a service key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: the password printed once by
#   backend: uv run python scripts/seed_demo.py --create-auth-users
# Without it, "Try as demo patient/psychologist" needs a backend POST /demo/login route, which
# does not exist yet, and reports that plainly instead of failing silently.
NEXT_PUBLIC_DEMO_PASSWORD=
