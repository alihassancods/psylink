# Copy to .env and adjust as needed.
# DATABASE_URL format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# Port 5433 = the db service in docker-compose.yml (5432 is taken by another project).
DATABASE_URL=postgresql+asyncpg://backend:backend@127.0.0.1:5433/backend
ENVIRONMENT=development

# --- Supabase JWT verification -------------------------------------------------------------
# Set EXACTLY ONE key source; without either one, authenticated routes answer 500.
# Hosted Supabase signs access tokens with RS256 and publishes the public keys at
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URI=
# Self-hosted / legacy GoTrue instead uses HS256 with the project's shared JWT secret.
SUPABASE_JWT_SECRET=
# Must match the aud claim Supabase puts in the token. "authenticated" is the default.
SUPABASE_JWT_AUDIENCE=authenticated
# Optional: also require an exact iss claim.
SUPABASE_ISSUER=

# --- Speech to text (AssemblyAI) -------------------------------------------------------------
# Create one at https://www.assemblyai.com/dashboard/home. Never commit the real key.
ASSEMBLYAI_API_KEY=
# Recording guardrails, enforced by POST /api/transcribe. Plain integers.
# MAX_AUDIO_MB caps the uploaded body; MAX_AUDIO_SECONDS is checked against the duration
# AssemblyAI reports for the clip (our ceiling; theirs is 10 hours, so they never reject it).
MAX_AUDIO_SECONDS=120
MAX_AUDIO_MB=10

# --- LLM analysis (Command Code Provider API) ------------------------------------------------
# OpenAI-compatible endpoint; same key authenticates CLI and API. Create one at
# https://commandcode.ai/settings/keys. Never commit the real key.
COMMANDCODE_API_KEY=
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
# Model used for check-in analysis. Must serve /chat/completions (Claude models do not —
# they are /messages only). Verify ids live: curl {COMMANDCODE_BASE_URL}/models
COMMANDCODE_MODEL=deepseek/deepseek-v4-flash
# Optional: tried once on transport errors / 5xx / 429. Leave empty to disable.
COMMANDCODE_FALLBACK_MODEL=

# --- Deploy surface --------------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS. Auth travels in the Authorization header,
# so credentials mode is off; an empty value grants no cross-origin access at all.
FRONTEND_ORIGIN=http://localhost:3000

# --- Clinician alerts ------------------------------------------------------------------------
# Optional. Without BOTH a key and a verified sender, alerts stay dashboard-only and the email
# step is skipped instead of failing the check-in.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
# A clinician is not emailed again about the same patient inside this window.
ALERT_DEDUPE_HOURS=6
